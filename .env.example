# Reference only: Relay does not load or bundle .env files.
# Enter SIP and ICE settings at runtime in Settings > SIP account.
SIP_WS_URL=wss://pbx.example.org:7443
SIP_DOMAIN=example.org
SIP_EXTENSION=
SIP_PASSWORD=
# Optional. Use servers you operate or are authorized to use.
STUN_URL=stun:turn.example.org:3478
TURN_URL=turn:turn.example.org:3478
TURN_USERNAME=
TURN_PASSWORD=
# Optional public build settings: --dart-define=RELAY_SENTRY_DSN=...
# Never pass SIP passwords or TURN credentials through --dart-define.
RELAY_SENTRY_DSN=
RELAY_APP_ENV=development
